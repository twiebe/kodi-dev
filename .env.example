# Add-on under test: host path to its source folder and its add-on id.
# The folder must contain an addon.xml (for JellyCon run `python build.py` once).
ADDON_DIR=/workspaces/jellycon
ADDON_ID=plugin.video.jellycon

JELLYFIN_VERSION=12.3

# Kodi version, taken from Debian packages. Pick the suite that ships it:
#   21.3 -> forky (testing), 21.2 -> trixie (Debian 13)
# Check: docker run --rm debian:<suite>-slim sh -c 'apt-get update -qq; apt-cache madison kodi'
# After a change: ./kdev up (rebuilds the image)
KODI_DEBIAN_SUITE=forky
KODI_VERSION=2:21.3*

# Uncomment to change ports or resolution
#JELLYFIN_PORT=8096
#KODI_RPC_PORT=8080
#KODI_VNC_PORT=5900
#KODI_RESOLUTION=1280x720

ROOT = os.path.dirname(os.path.realpath(__file__))
INSTANCES = os.path.join(ROOT, 'instances')
# Host ports of the default environment; instance k adds 10*k (VNC: k)
PORTS = {'JELLYFIN_PORT': 8096, 'FAULTPROXY_PORT': 8097, 'KODI_RPC_PORT': 8080, 'KODI_VNC_PORT': 5900}

# Set by use_instance(): the default environment uses data/ and project kodi-dev
INSTANCE = None
PROJECT = DATA = SEED_FILE = KODI_HOME = KODI_LOG = FAULTS = FAULT_LOG = None

JF_ADMIN = ('admin', 'admin')
JF_USERS = [('tester', 'tester'), ('nopass', '')]
JF_INTERNAL_URL = 'http://jellyfin:8096'
CLIENT_AUTH = 'MediaBrowser Client="kodi-dev", Device="kdev", DeviceId="kdev", Version="1.0"'

# Test media: (library folder, relative path, nfo xml). Ten minutes each, so
# Jellyfin's default minimum resume duration (5 min) does not swallow progress.
MEDIA_SECONDS = 600

    ('shows', 'Kdev Show/Season 01/Kdev Show S01E01.mkv',
     '<episodedetails><title>Pilot</title><season>1</season><episode>1</episode></episodedetails>'),
    ('shows', 'Kdev Show/Season 01/Kdev Show S01E02.mkv',
     '<episodedetails><title>Second</title><season>1</season><episode>2</episode></episodedetails>'),
    ('shows', 'Kdev Show/Season 01/Kdev Show S01E03.mkv',
     '<episodedetails><title>Third</title><season>1</season><episode>3</episode></episodedetails>'),
]
SHOW_NFO = ('shows', 'Kdev Show/tvshow.nfo', '<tvshow><title>Kdev Show</title><year>2003</year></tvshow>')


def read_env(path):
    values = {}
    if os.path.exists(path):
        for line in open(path):
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                key, value = line.split('=', 1)
                values[key.strip()] = value.strip().strip('"\'')
    return values


def env():
    """Values from .env, then for an instance its .env and ports, overridden by the
    process environment."""
    values = read_env(os.path.join(ROOT, '.env'))
    if INSTANCE:
        folder = os.path.join(INSTANCES, INSTANCE)
        values.update(read_env(os.path.join(folder, '.env')))
        values.update(read_env(os.path.join(folder, 'ports.env')))
    values.update({k: v for k, v in os.environ.items() if k in values or k.startswith(('KODI_', 'JELLYFIN_', 'ADDON_'))})
    values['KDEV_DATA'] = DATA
    return values


def kodi_user():
    """The Jellyfin user add-on profiles sign in as."""
    return env().get('KDEV_USER', 'tester')


def instance_names():
    if not os.path.isdir(INSTANCES):
        return []
    return sorted(n for n in os.listdir(INSTANCES) if os.path.exists(os.path.join(INSTANCES, n, 'ports.env')))


def use_instance(name):
    """Point kdev at the default environment (name None) or at an instance: its own
    compose project, data folder and host ports, created on first use."""
    global INSTANCE, PROJECT, DATA, SEED_FILE, KODI_HOME, KODI_LOG, FAULTS, FAULT_LOG
    INSTANCE = name or None
    if INSTANCE is None:
        PROJECT, DATA = 'kodi-dev', os.path.join(ROOT, 'data')
    else:
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,30}', INSTANCE):
            die('instance names are lower case letters, digits and -, e.g. save-password')
        folder = os.path.join(INSTANCES, INSTANCE)
        PROJECT, DATA = 'kodi-dev-' + INSTANCE, os.path.join(folder, 'data')
        ports = os.path.join(folder, 'ports.env')
        if not os.path.exists(ports):
            slot = free_slot(*slots_in_use())
            os.makedirs(folder, exist_ok=True)
            with open(ports, 'w') as f:
                f.write('KDEV_SLOT={}\n'.format(slot))
                for key, port in slot_ports(slot).items():
                    f.write('{}={}\n'.format(key, port))
    SEED_FILE = os.path.join(DATA, 'seed.json')
    KODI_HOME = os.path.join(DATA, 'kodi')
    KODI_LOG = os.path.join(KODI_HOME, 'temp', 'kodi.log')
    FAULTS = os.path.join(DATA, 'faults', 'faults.json')
    FAULT_LOG = os.path.join(DATA, 'faults', 'faults.log')


def slot_ports(slot):
    return {key: port + (slot if key == 'KODI_VNC_PORT' else 10 * slot) for key, port in PORTS.items()}


def free_slot(used_slots, busy_ports):
    """First slot k >= 1 that no instance has and whose ports nobody listens on."""
    return next(k for k in range(1, 100)
                if k not in used_slots and not busy_ports & set(slot_ports(k).values()))


def parse_docker_ports(lines):
    """Host ports from `docker ps --format {{.Ports}}`, e.g. 127.0.0.1:8117->8096/tcp."""
    return {int(port) for line in lines for port in re.findall(r':(\d+)->', line)}


def slots_in_use():
    """Slots of the instances in this checkout, plus the ports of the instances in the other
    git worktrees of kodi-dev (each has its own instances/) and the host ports Docker
    publishes right now."""
    worktrees = subprocess.run(['git', 'worktree', 'list', '--porcelain'], cwd=ROOT, text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    roots = {ROOT} | {os.path.realpath(line[9:]) for line in worktrees.splitlines() if line.startswith('worktree ')}
    slots, ports = set(), set()
    for root in roots:
        folder = os.path.join(root, 'instances')
        for name in os.listdir(folder) if os.path.isdir(folder) else []:
            values = read_env(os.path.join(folder, name, 'ports.env'))
            if root == ROOT and values.get('KDEV_SLOT', '').isdigit():
                slots.add(int(values['KDEV_SLOT']))
            ports |= {int(v) for k, v in values.items() if k in PORTS and v.isdigit()}
    try:
        published = subprocess.run(['docker', 'ps', '--format', '{{.Ports}}'], text=True,
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
    except OSError:
        published = ''
    return slots, ports | parse_docker_ports(published.splitlines())


def die(message):
    print('kdev: ' + message, file=sys.stderr)
    sys.exit(1)


# --- docker -----------------------------------------------------------------

def compose_files():
    """compose.yaml and compose.override.yaml, plus instances/NAME/compose.yaml for an
    instance, e.g. to mount another checkout of an add-on or skin."""
    files = ['compose.yaml']
    if os.path.exists(os.path.join(ROOT, 'compose.override.yaml')):
        files.append('compose.override.yaml')
    if INSTANCE and os.path.exists(os.path.join(INSTANCES, INSTANCE, 'compose.yaml')):
        files.append(os.path.join(INSTANCES, INSTANCE, 'compose.yaml'))
    return [arg for f in files for arg in ('-f', f)]


def compose(*args, check=True, capture=False):
    cmd = ['docker', 'compose', '-p', PROJECT] + compose_files() + list(args)
    # Variables of the process override .env when compose fills in compose.yaml
    result = subprocess.run(cmd, cwd=ROOT, text=True, env=dict(os.environ, **env()),
                            stdout=subprocess.PIPE if capture else None)
    if check and result.returncode != 0:
        die('`{}` failed'.format(' '.join(cmd)))
    return result.stdout if capture else result.returncode


def kodi_exec(*args, check=True, capture=False):
    return compose('exec', '-T', 'kodi', *args, check=check, capture=capture)


# --- http -------------------------------------------------------------------

def http(method, url, body=None, headers=None, timeout=30):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers=headers or {})
    if data is not None:
        req.add_header('Content-Type', 'application/json')
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            raw = res.read()
            return res.status, json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            return e.code, raw.decode(errors='replace')


def rpc(method, params=None):
    url = 'http://localhost:{}/jsonrpc'.format(env().get('KODI_RPC_PORT', '8080'))
    status, res = http('POST', url, {'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params or {}})
    if status != 200 or not isinstance(res, dict):
        die('JSON-RPC {} failed: HTTP {} {}'.format(method, status, res))
    if 'error' in res:
        die('JSON-RPC {} failed: {}'.format(method, json.dumps(res['error'])))
    return res['result']


def jf_url(path):
    return 'http://localhost:{}{}'.format(env().get('JELLYFIN_PORT', '8096'), path)


def jf(method, path, body=None, token=None, auth=CLIENT_AUTH):
    header = auth + (', Token="{}"'.format(token) if token else '')
    return http(method, jf_url(path), body, {'Authorization': header})


def jf_ok(method, path, body=None, token=None, auth=CLIENT_AUTH):
    status, res = jf(method, path, body, token, auth)
    if status >= 300:
        die('Jellyfin {} {} -> HTTP {} {}'.format(method, path, status, res))
    return res


def load_seed():
    if not os.path.exists(SEED_FILE):
        die('no seed data, run `./kdev seed` first')
    return json.load(open(SEED_FILE))


def admin_token():
    return load_seed()['admin']['token']


def wait_for(check, timeout, what):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if check():
                return
        except OSError:
            pass
        time.sleep(1)
    die('timed out waiting for ' + what)


# --- environment lifecycle --------------------------------------------------

def ensure_dirs():
    for path in ('kodi', 'jellyfin/config', 'jellyfin/cache', 'media', 'faults'):
        os.makedirs(os.path.join(DATA, path), exist_ok=True)


def kodi_ready():
    return kodi_exec('test', '-e', '/tmp/kodi-dev-ready', check=False) == 0


def cmd_up(args):
    ensure_dirs()
    compose('up', '-d', '--build')
    cmd_wait(args)


def cmd_down(args):
    compose('down')


def jellyfin_ready():
    # While it starts, Jellyfin 12 answers from a temporary server that it then shuts down
    status, info = jf('GET', '/System/Info/Public')
    return status == 200 and isinstance(info, dict) and bool(info.get('Id'))


def cmd_wait(args):
    wait_for(kodi_ready, 180, 'Kodi')
    wait_for(jellyfin_ready, 180, 'Jellyfin')
    print('kdev: Kodi and Jellyfin are up')


def kodi_pids():
    return set(kodi_exec('pgrep', '-x', 'kodi.bin', check=False, capture=True).split())


def cmd_restart(args):
    """Restart Kodi only (the entrypoint relaunches it), e.g. after code changes."""
    if 'kodi' not in compose('ps', '--status', 'running', '--services', capture=True).split():
        # Stopped container, e.g. to edit its databases: start it instead
        compose('start', 'kodi')
        wait_for(kodi_ready, 180, 'Kodi start')
        print('kdev: Kodi started')
        return
    old = kodi_pids()
    kodi_exec('rm', '-f', '/tmp/kodi-dev-ready')
    try:
        rpc('Application.Quit')
    except (SystemExit, OSError):
        pass
    # The entrypoint starts the next Kodi as soon as this one is gone: wait for the old process
    # only. Kodi hangs on exit when an add-on's Python threads do not stop.
    for _ in range(20):
        if not old & kodi_pids():
            break
        time.sleep(1)
    else:
        for pid in sorted(old & kodi_pids()):
            print('kdev: Kodi did not exit within 20s, killing it', file=sys.stderr)
            kodi_exec('kill', '-KILL', pid, check=False)
    wait_for(kodi_ready, 180, 'Kodi restart')
    print('kdev: Kodi restarted')


def cmd_instances(args):
    rows = [('(default)', 'kodi-dev', env_for(None))] + [(n, 'kodi-dev-' + n, env_for(n)) for n in instance_names()]
    for name, project, values in rows:
        running = subprocess.run(['docker', 'compose', '-p', project, 'ps', '--status', 'running', '-q'],
                                 cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.split()
        print('{:<16} {:<8} jellyfin {:<5} faultproxy {:<5} rpc {:<5} vnc {:<5} {}'.format(
            name, 'up' if running else 'down', values['JELLYFIN_PORT'], values['FAULTPROXY_PORT'],
            values['KODI_RPC_PORT'], values['KODI_VNC_PORT'], values.get('ADDON_ID', '')))


def env_for(name):
    previous = INSTANCE
    use_instance(name)
    values = dict({k: str(v) for k, v in PORTS.items()}, **env())
    use_instance(previous)
    return values


def wipe_data(path=None):
    # Containers may have created files as another user: delete from inside one
    path = path or DATA
    if os.path.isdir(path):
        subprocess.run(['docker', 'run', '--rm', '-v', path + ':/data', 'alpine:3.20',
                        'sh', '-c', 'rm -rf /data/* /data/.[!.]*'], check=True)


def cmd_remove(args):
    if not INSTANCE:
        die('remove deletes an instance, pick one with -i NAME (the default environment: reset)')
    if not args.yes:
        die('this deletes instance {} with all its data; add --yes'.format(INSTANCE))
    compose('down')
    wipe_data()
    shutil.rmtree(os.path.join(INSTANCES, INSTANCE))
    print('kdev: instance {} removed'.format(INSTANCE))


def cmd_reset(args):
    if not args.yes:
        die('this deletes {} (Kodi profile, Jellyfin config, media); add --yes'.format(DATA))
    if INSTANCE in pool_workers():
        pool_reset([INSTANCE], start=True)
        return
    compose('down')
    wipe_data()
    cmd_up(args)
    cmd_seed(args)


# --- seeding ----------------------------------------------------------------

def seed_media():
    media = os.path.join(DATA, 'media')
    todo = [m for m in MEDIA if not os.path.exists(os.path.join(media, m[0], m[1]))]
    for lib, rel, nfo in MEDIA + [SHOW_NFO]:
        path = os.path.join(media, lib, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        nfo_path = path if rel.endswith('.nfo') else os.path.splitext(path)[0] + '.nfo'
        with open(nfo_path, 'w') as f:
            f.write('<?xml version="1.0" encoding="UTF-8"?>\n' + nfo + '\n')
    for i, (lib, rel, _) in enumerate(todo):
        print('kdev: generating /media/{}/{}'.format(lib, rel))
        # Each clip gets its own tone, so audio is distinguishable too
        compose('run', '--rm', '--no-deps', '-T', '-v', media + ':/out',
                '--entrypoint', '/usr/lib/jellyfin-ffmpeg/ffmpeg', 'jellyfin',
                '-loglevel', 'error', '-y',
                '-f', 'lavfi', '-i', 'testsrc2=size=640x360:rate=10',
                '-f', 'lavfi', '-i', 'sine=frequency={}'.format(330 + 110 * i),
                '-t', str(MEDIA_SECONDS), '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '35',
                '-c:a', 'aac', '-b:a', '32k', '/out/{}/{}'.format(lib, rel))


def seed_jellyfin():
    status, info = jf('GET', '/System/Info/Public')
    if status != 200:
        die('Jellyfin not reachable (HTTP {})'.format(status))
    name, password = JF_ADMIN
    if not info.get('StartupWizardCompleted'):
        print('kdev: running Jellyfin startup wizard')
        jf_ok('POST', '/Startup/Configuration',
              {'UICulture': 'en-US', 'MetadataCountryCode': 'US', 'PreferredMetadataLanguage': 'en'})
        jf_ok('GET', '/Startup/User')
        jf_ok('POST', '/Startup/User', {'Name': name, 'Password': password})
        jf_ok('POST', '/Startup/RemoteAccess', {'EnableRemoteAccess': True, 'EnableAutomaticPortMapping': False})
        jf_ok('POST', '/Startup/Complete')

    login = jf_ok('POST', '/Users/AuthenticateByName', {'Username': name, 'Pw': password})
    token = login['AccessToken']
    seed = {'server': {'internal': JF_INTERNAL_URL, 'external': jf_url('')},
            'admin': {'name': name, 'password': password, 'id': login['User']['Id'], 'token': token},
            'users': {}}

    # API key for scripts, independent of any user session
    keys = jf_ok('GET', '/Auth/Keys', token=token)['Items']
    if not any(k.get('AppName') == 'kodi-dev' for k in keys):
        jf_ok('POST', '/Auth/Keys?app=kodi-dev', token=token)
        keys = jf_ok('GET', '/Auth/Keys', token=token)['Items']
    seed['admin']['api_key'] = next(k['AccessToken'] for k in keys if k.get('AppName') == 'kodi-dev')

    existing = {u['Name']: u for u in jf_ok('GET', '/Users', token=token)}
    for user_name, user_password in JF_USERS:
        user = existing.get(user_name) or jf_ok('POST', '/Users/New',
                                                {'Name': user_name, 'Password': user_password}, token=token)
        seed['users'][user_name] = {'id': user['Id'], 'password': user_password}

    folders = {f['Name'] for f in jf_ok('GET', '/Library/VirtualFolders', token=token)}
    no_fetchers = {'LibraryOptions': {
        'EnableRealtimeMonitor': False,
        'TypeOptions': [{'Type': t, 'MetadataFetchers': [], 'ImageFetchers': []}
                        for t in ('Movie', 'Series', 'Season', 'Episode')]}}
    for lib_name, ctype, path in (('Movies', 'movies', '/media/movies'), ('Shows', 'tvshows', '/media/shows')):
        if lib_name not in folders:
            print('kdev: creating library ' + lib_name)
            query = urllib.parse.urlencode({'name': lib_name, 'collectionType': ctype,
                                            'paths': path, 'refreshLibrary': 'true'})
            jf_ok('POST', '/Library/VirtualFolders?' + query, no_fetchers, token=token)

    expected = len(MEDIA)

    def scanned():
        res = jf_ok('GET', '/Items?Recursive=true&IncludeItemTypes=Movie,Episode', token=token)
        return res['TotalRecordCount'] >= expected
    if not scanned():
        jf_ok('POST', '/Library/Refresh', token=token)
        wait_for(scanned, 300, 'library scan')
    items = jf_ok('GET', '/Items?Recursive=true&IncludeItemTypes=Movie,Series,Episode', token=token)['Items']
    seed['items'] = {i['Name'] if i['Type'] != 'Episode' else '{} {}'.format(i['SeriesName'], i['Name']): i['Id']
                     for i in items}

    with open(SEED_FILE, 'w') as f:
        json.dump(seed, f, indent=2)
    print('kdev: Jellyfin seeded, details in ' + os.path.relpath(SEED_FILE))
    return seed


def load_profile(addon_id):
    path = os.path.join(ROOT, 'profiles', addon_id + '.py')
    if not os.path.exists(path):
        return None
    spec = importlib.util.spec_from_file_location('profile_' + addon_id.replace('.', '_'), path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def profile_ids():
    """ADDON_ID and every other add-on in the Kodi profile that has a profile in profiles/."""
    addon_id = env().get('ADDON_ID')
    ids = [addon_id] if addon_id else []
    for name in sorted(os.listdir(os.path.join(ROOT, 'profiles'))):
        other = name[:-3]
        if name.endswith('.py') and other not in ids and os.path.isdir(os.path.join(KODI_HOME, 'addons', other)):
            ids.append(other)
    return [i for i in ids if os.path.exists(os.path.join(ROOT, 'profiles', i + '.py'))]


def apply_profiles(seed, args):
    """Run the add-on profiles while Kodi is stopped (add-ons may write their settings on exit)."""
    ids = profile_ids()
    if not ids:
        return
    running = 'kodi' in compose('ps', '--status', 'running', '--services', capture=True).split()
    if running:
        compose('stop', 'kodi')
    for addon_id in ids:
        print('kdev: applying profile {} for {}'.format(addon_id, kodi_user()))
        load_profile(addon_id).seed(sys.modules[__name__], seed, args)
    if running:
        compose('start', 'kodi')
        wait_for(kodi_ready, 180, 'Kodi start')
        print('kdev: Kodi started')


def cmd_seed(args):
    ensure_dirs()
    seed_media()
    seed = seed_jellyfin()
    apply_profiles(seed, args)


# --- Kodi interaction -------------------------------------------------------

def cmd_rpc(args):
    params = json.loads(args.params) if args.params else {}
    print(json.dumps(rpc(args.method, params), indent=2, ensure_ascii=False))


def cmd_builtin(args):
    kodi_exec('kodi-send', '--action=' + args.command, capture=True)


def cmd_action(args):
    for action in args.actions:
        rpc('Input.ExecuteAction', {'action': action})
        time.sleep(args.delay)


def cmd_ls(args):
    res = rpc('Files.GetDirectory', {'directory': args.url, 'media': 'video',
                                     'properties': ['title', 'playcount', 'resume', 'file']})
    items = res.get('files') or []
    if args.json:
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return
    for item in items:
        resume = item.get('resume') or {}
        state = []
        if item.get('playcount'):
            state.append('watched')
        if resume.get('position'):
            state.append('resume {:.0f}s'.format(resume['position']))
        path = item.get('file', '')
        if not args.full and len(path) > 100:
            path = path[:97] + '...'
        print('{:<40} {:<20} {}'.format(item.get('label', ''), ', '.join(state), path))


def cmd_screenshot(args):
    name = args.name or time.strftime('%Y%m%d-%H%M%S')
    target = '/home/kodi/.kodi/screenshots/{}.png'.format(name)
    kodi_exec('import', '-window', 'root', target)
    print(os.path.join(KODI_HOME, 'screenshots', name + '.png'))


def cmd_log(args):
    if not os.path.exists(KODI_LOG):
        die('no kodi.log yet')
    lines = open(KODI_LOG, errors='replace').read().splitlines()
    if not args.all:
        # Only the current Kodi run
        starts = [i for i, line in enumerate(lines) if 'Starting Kodi' in line]
        if starts:
            lines = lines[starts[-1]:]
    if args.grep:
        lines = [line for line in lines if args.grep.lower() in line.lower()]
    for line in lines[-args.lines:]:
        print(line)


# --- Jellyfin interaction ---------------------------------------------------

def cmd_jf(args):
    token = load_seed()['admin']['api_key']
    body = json.loads(args.body) if args.body else None
    status, res = jf(args.method.upper(), args.path, body, token=token)
    print('HTTP {}'.format(status), file=sys.stderr)
    if res is not None:
        print(json.dumps(res, indent=2, ensure_ascii=False) if not isinstance(res, str) else res)
    sys.exit(0 if status < 300 else 1)


def cmd_user(args):
    seed = load_seed()
    token = seed['admin']['api_key']
    user = seed['users'].get(args.name) or die('unknown user ' + args.name)
    path = '/Users/{}'.format(user['id'])
    if args.state:
        policy = jf_ok('GET', path, token=token)['Policy']
        policy['IsDisabled'] = args.state == 'disable'
        jf_ok('POST', path + '/Policy', policy, token=token)
    current = jf_ok('GET', path, token=token)
    print('{}: {}'.format(args.name, 'disabled' if current['Policy']['IsDisabled'] else 'enabled'))


def cmd_userdata(args):
    """Played state and resume position of an item as the server sees it."""
    seed = load_seed()
    user = seed['users'].get(args.user) or die('unknown user ' + args.user)
    item_id = seed['items'].get(args.item, args.item)
    item = jf_ok('GET', '/Items/{}?userId={}'.format(item_id, user['id']), token=seed['admin']['api_key'])
    data = item.get('UserData', {})
    print(json.dumps({'Name': item.get('Name'), 'Played': data.get('Played'),
                      'PlayCount': data.get('PlayCount'),
                      'PositionSeconds': data.get('PlaybackPositionTicks', 0) / 10_000_000},
                     indent=2))


# --- fault injection --------------------------------------------------------



def load_faults():
    try:
        with open(FAULTS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {'rules': []}


def cmd_fault(args):
    """Fail requests that go through the fault proxy (http://faultproxy:8096)."""
    ensure_dirs()
    if args.action == 'clear':
        faults = {'rules': []}
        open(FAULT_LOG, 'w').close()
    else:
        faults = load_faults()
    if args.match and args.action != 'add':
        die('only fault add takes MATCH')
    if args.action == 'add':
        if not args.match:
            die('fault add needs MATCH, a regular expression for the request path')
        rule = {'match': args.match}
        if args.method:
            rule['method'] = args.method.upper()
        if args.drop:
            rule['drop'] = True
        elif args.body is not None:
            rule['body'] = args.body
            rule['status'] = args.status or 200
            rule['content_type'] = args.content_type
        elif args.delay is not None:
            rule['delay'] = args.delay
        else:
            rule['status'] = args.status or 500
        if args.times is not None:
            rule['times'] = args.times
        faults['rules'].append(rule)
    if args.action in ('add', 'clear'):
        # Replace the file in one step, the proxy reads and writes it too
        tmp = FAULTS + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(faults, f, indent=2)
        os.replace(tmp, FAULTS)
    print(json.dumps(faults, indent=2))
    if os.path.exists(FAULT_LOG):
        with open(FAULT_LOG) as f:
            hits = f.read().splitlines()
        if hits:
            print('fired:', *hits[-args.lines:], sep='\n  ')


# --- pool -------------------------------------------------------------------
# N independent environments (instances pool-0, pool-1, ...) for parallel tests, each with its
# own Jellyfin, fault proxy and Kodi. They start as copies of one seeded environment, the
# pool's template in instances/pool/data: Jellyfin config, media (hard links), the Kodi
# profile (kodi-template) and seed.json, taken together so the Kodi library matches the server.

POOL = 'pool'
POOL_RESERVE_GB = 1.5   # left for everything else on the machine
POOL_WORKER_GB = 1.0    # one Kodi (about 410 MB), its Jellyfin (about 280 MB) and fault proxy
POOL_MAX = 8
# Not copied into the Kodi template: screenshots, logs, downloaded zips, perf/ leftovers
TEMPLATE_SKIP = ('screenshots/*', 'addons/packages/*', 'temp/*.log', 'temp/*.out', 'temp/kodi-dev-keep-disabled')
# Device ids of the add-ons: each worker makes its own
TEMPLATE_RESET = ('temp/jellycon_guid', 'userdata/addon_data/plugin.video.jellyfin/jellyfin_guid')

POOL_WORKER_COMPOSE = '''\
# Written by kdev pool up: add-on folders mounted in every worker
services:
  kodi:
    volumes:
{volumes}'''


def pool_size(available, cores, running=0, reserve=POOL_RESERVE_GB, per_worker=POOL_WORKER_GB,
              maximum=POOL_MAX):
    """Number of workers that fit into AVAILABLE GB (MemAvailable). A running pool already
    took its share, so its workers count as available. Returns (N, explanation)."""
    usable = available + running * per_worker
    by_memory = int((usable - reserve) / per_worker + 1e-9)
    n = max(1, min(by_memory, cores // 2, maximum))
    credit = ' + running pool {:.1f} GB'.format(usable - available) if usable > available else ''
    return n, ('(MemAvailable {:.1f} GB{} - reserve {} GB) / {} GB per worker = {}, '
               'cores {} / 2 = {}, max {}: N = {}'.format(available, credit, reserve, per_worker,
                                                          by_memory, cores, cores // 2, maximum, n))


def worker_compose(mounts):
    """compose.yaml of a worker: the add-on MOUNTS on top of the default setup, None without."""
    if not mounts:
        return None
    return POOL_WORKER_COMPOSE.format(volumes=''.join('      - {}\n'.format(m) for m in mounts))


def mem_available_gb():
    for line in open('/proc/meminfo'):
        if line.startswith('MemAvailable:'):
            return int(line.split()[1]) / 1024 ** 2
    die('no MemAvailable in /proc/meminfo')


@contextlib.contextmanager
def on_instance(name):
    previous = INSTANCE
    use_instance(name)
    try:
        yield
    finally:
        use_instance(previous)


def running_services():
    return set(compose('ps', '--status', 'running', '--services', capture=True).split())


def write_file(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        f.write(text)


def pool_workers():
    names = [n for n in instance_names() if n.startswith(POOL + '-') and n[len(POOL) + 1:].isdigit()]
    return sorted(names, key=lambda n: int(n[len(POOL) + 1:]))


def docker(*args, check=True, capture=True):
    result = subprocess.run(['docker', *args], text=True, stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.PIPE if capture else None)
    if check and result.returncode != 0:
        die('`docker {}` failed: {}'.format(' '.join(args), (result.stderr or '').strip()))
    return result


def in_use_by_container(path):
    """Whether a running container mounts PATH or something below it."""
    ids = docker('ps', '-q').stdout.split()
    if not ids:
        return False
    mounts = docker('inspect', '--format', '{{range .Mounts}}{{println .Source}}{{end}}', *ids).stdout.split()
    path = os.path.realpath(path)
    return any(m == path or m.startswith(path + os.sep) for m in mounts)


def copy_tree(source, target, link=False):
    """Copy the contents of SOURCE into TARGET; LINK hard-links files where possible."""
    os.makedirs(target, exist_ok=True)
    if link and subprocess.run(['cp', '-al', source + '/.', target], stderr=subprocess.DEVNULL).returncode == 0:
        return
    subprocess.run(['cp', '-a', source + '/.', target], check=True)


def pool_data():
    return os.path.join(INSTANCES, POOL, 'data')


def pool_template():
    return os.path.join(pool_data(), 'kodi-template')


def pool_copy_source(source):
    """Make the pool's template from a seeded kodi-dev data folder."""
    if not source or not os.path.exists(os.path.join(source, 'seed.json')):
        die('{} holds no seeded environment: run ./kdev seed there first, or pass --from with '
            'another data folder'.format(source))
    if in_use_by_container(source):
        die('{} is in use by running containers; stop that environment while the pool copies it '
            '(once), or pass --from with another data folder'.format(source))
    print('kdev: copying Jellyfin, media and the Kodi profile from {} as pool template'.format(source))
    copy_tree(os.path.join(source, 'jellyfin', 'config'), os.path.join(pool_data(), 'jellyfin', 'config'))
    copy_tree(os.path.join(source, 'media'), os.path.join(pool_data(), 'media'), link=True)
    copy_tree(os.path.join(source, 'kodi'), pool_template())
    for pattern in TEMPLATE_SKIP:
        for path in glob.glob(os.path.join(pool_template(), pattern)):
            shutil.rmtree(path) if os.path.isdir(path) and not os.path.islink(path) else os.remove(path)
    shutil.copy(os.path.join(source, 'seed.json'), os.path.join(pool_data(), 'seed.json'))


def addon_mounts(folders):
    mounts = []
    for folder in folders:
        folder = os.path.realpath(folder)
        try:
            addon_id = ET.parse(os.path.join(folder, 'addon.xml')).getroot().get('id')
        except (OSError, ET.ParseError) as e:
            die('{} is no add-on folder ({})'.format(folder, e))
        mounts.append('{}:/home/kodi/.kodi/addons/{}'.format(folder, addon_id))
    return mounts


def pool_worker(name, mounts, fresh):
    """Write the worker's compose file (MOUNTS None keeps it); with FRESH or on first use give
    it a new copy of the template."""
    with on_instance(name):
        compose_file = os.path.join(INSTANCES, name, 'compose.yaml')
        if mounts is not None:
            text = worker_compose(mounts)
            if text:
                write_file(compose_file, text)
            elif os.path.exists(compose_file):
                os.remove(compose_file)
        if fresh or not os.path.exists(SEED_FILE):
            compose('down')
            wipe_data()
            ensure_dirs()
            print('kdev: {} gets a copy of the pool template'.format(name))
            copy_tree(os.path.join(pool_data(), 'jellyfin', 'config'), os.path.join(DATA, 'jellyfin', 'config'))
            copy_tree(os.path.join(pool_data(), 'media'), os.path.join(DATA, 'media'), link=True)
            copy_tree(pool_template(), KODI_HOME)
            for path in TEMPLATE_RESET:
                if os.path.exists(os.path.join(KODI_HOME, path)):
                    os.remove(os.path.join(KODI_HOME, path))
            shutil.copy(os.path.join(pool_data(), 'seed.json'), SEED_FILE)
            # the profiles sign the add-ons in on the worker's own Jellyfin
            compose('up', '-d', 'jellyfin')
            wait_for(jellyfin_ready, 180, 'Jellyfin of ' + name)
            apply_profiles(load_seed(), argparse.Namespace())


def pool_start(names):
    for name in names:
        with on_instance(name):
            ensure_dirs()
            compose('up', '-d', '--build')
    for name in names:
        with on_instance(name):
            wait_for(kodi_ready, 300, 'Kodi of ' + name)
            wait_for(jellyfin_ready, 180, 'Jellyfin of ' + name)
    print('kdev: pool workers up: ' + ' '.join(names))


def pool_running():
    """Number of running workers"""
    running = 0
    for name in pool_workers():
        with on_instance(name):
            running += 'kodi' in running_services()
    return running


def pool_up(args):
    size = args.size or os.environ.get('KDEV_POOL_SIZE')
    if size:
        n = int(size)
        print('kdev: pool size {} (given)'.format(n))
    else:
        n, text = pool_size(mem_available_gb(), os.cpu_count(), pool_running())
        print('kdev: pool size ' + text)
    if not os.path.exists(os.path.join(pool_data(), 'seed.json')):
        pool_copy_source(args.source)
    names = ['{}-{}'.format(POOL, k) for k in range(n)]
    mounts = addon_mounts(args.addon) if args.addon else None
    for name in names:
        pool_worker(name, mounts, fresh=False)
    for name in pool_workers():
        if name not in names:
            with on_instance(name):
                if running_services():
                    print('kdev: stopping ' + name)
                    compose('down')
    pool_start(names)


def pool_down(args):
    for name in pool_workers():
        with on_instance(name):
            compose('down')


def pool_reset(names, start=False):
    """New copies of the template for the workers NAMES. Starts the ones that ran before,
    with START all of them."""
    running = []
    for name in names:
        with on_instance(name):
            if start or running_services():
                running.append(name)
    for name in names:
        pool_worker(name, None, fresh=True)
    if running:
        pool_start(running)


def rss_mib(container):
    """Resident memory of all processes in a running container, in MiB (docker stats and
    docker top do not work under every runtime, /proc does)."""
    result = docker('exec', container, 'sh', '-c',
                    "cat /proc/[0-9]*/status 2>/dev/null | awk '/^VmRSS/ {s += $2} END {print s}'", check=False)
    return int(result.stdout.strip()) / 1024 if result.returncode == 0 and result.stdout.strip().isdigit() else None


def pool_status(args):
    def mib(project, service):
        value = rss_mib('{}-{}-1'.format(project, service))
        return '{:.0f} MiB'.format(value) if value is not None else '-'
    if not os.path.exists(os.path.join(pool_data(), 'seed.json')):
        print('kdev: no pool, start one with ./kdev pool up')
        return
    for name in pool_workers():
        with on_instance(name):
            values = env()
            state = 'up' if 'kodi' in running_services() else 'down'
            compose_file = os.path.join(INSTANCES, name, 'compose.yaml')
            mounts = re.findall(r'- (\S+):/home/kodi', open(compose_file).read()) if os.path.exists(compose_file) else []
            print('{:<8} {:<5} rpc {:<5} vnc {:<5} jellyfin {:<5} faultproxy {:<5} kodi {:>9} jellyfin {:>9} {}'.format(
                name, state, values['KODI_RPC_PORT'], values['KODI_VNC_PORT'], values['JELLYFIN_PORT'],
                values['FAULTPROXY_PORT'], mib(PROJECT, 'kodi'), mib(PROJECT, 'jellyfin'), ' '.join(mounts)))
    print('kdev: ' + pool_size(mem_available_gb(), os.cpu_count(), pool_running())[1])


def pool_remove(args):
    if not args.yes:
        die('this deletes the pool with its workers, template and data; add --yes')
    pool_down(args)
    for name in pool_workers() + [POOL]:
        folder = os.path.join(INSTANCES, name)
        if os.path.isdir(folder):
            wipe_data(os.path.join(folder, 'data'))
            shutil.rmtree(folder)
    print('kdev: pool removed')


def cmd_pool(args):
    if args.action == 'up':
        pool_up(args)
    elif args.action == 'down':
        pool_down(args)
    elif args.action == 'status':
        pool_status(args)
    elif args.action == 'reset':
        pool_reset(pool_workers())
    elif args.action == 'remove':
        pool_remove(args)


def main():
    parser = argparse.ArgumentParser(prog='kdev', description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('-i', '--instance', default=os.environ.get('KDEV_INSTANCE'),
                        help='work on a separate instance with its own containers, data and ports '
                             '(also KDEV_INSTANCE); created on first use, e.g. ./kdev -i b reset --yes')
    sub = parser.add_subparsers(dest='cmd', required=True)

    sub.add_parser('up', help='build and start Kodi and Jellyfin, wait until ready').set_defaults(func=cmd_up)
    sub.add_parser('down', help='stop the environment').set_defaults(func=cmd_down)
    sub.add_parser('instances', help='list the default environment and the instances').set_defaults(func=cmd_instances)
    p = sub.add_parser('remove', help='stop an instance and delete it with its data')
    p.add_argument('--yes', action='store_true')
    p.set_defaults(func=cmd_remove)
    sub.add_parser('wait', help='wait until Kodi and Jellyfin are ready').set_defaults(func=cmd_wait)
    sub.add_parser('restart', help='restart Kodi (reloads add-on code)').set_defaults(func=cmd_restart)
    p = sub.add_parser('reset', help='wipe all data, start and seed from scratch')
    p.add_argument('--yes', action='store_true')
    p.set_defaults(func=cmd_reset)
    sub.add_parser('seed', help='create test media, Jellyfin users/libraries, apply add-on profile'
                   ).set_defaults(func=cmd_seed)

    p = sub.add_parser('pool', help='N independent environments (pool-0 ...) for parallel tests',
                       description='up [N]: start the pool (N from free memory when omitted, or KDEV_POOL_SIZE); '
                                   'down: stop it, keep data; status: workers, ports, memory; '
                                   'reset: new copies of the template for all workers; remove --yes: delete it')
    p.add_argument('action', choices=('up', 'down', 'status', 'reset', 'remove'))
    p.add_argument('size', nargs='?', type=int, help='number of workers (up only)')
    p.add_argument('--addon', '--skin', action='append', metavar='DIR',
                   help='mount this add-on folder in every worker instead of the configured one, '
                        'e.g. a skin worktree (up only, repeatable)')
    p.add_argument('--from', dest='source', default=os.path.join(ROOT, 'data'),
                   help='seeded data folder the pool copies its template from on first use '
                        '(default: data/ of the default environment)')
    p.add_argument('--yes', action='store_true')
    p.set_defaults(func=cmd_pool)

    p = sub.add_parser('rpc', help='call a Kodi JSON-RPC method')
    p.add_argument('method')
    p.add_argument('params', nargs='?', help='JSON object')
    p.set_defaults(func=cmd_rpc)
    p = sub.add_parser('builtin', help='run a Kodi builtin, e.g. "RunPlugin(plugin://...)"')
    p.add_argument('command')
    p.set_defaults(func=cmd_builtin)
    p = sub.add_parser('action', help='send input actions, e.g. down down select contextmenu back')
    p.add_argument('actions', nargs='+')
    p.add_argument('--delay', type=float, default=0.5)
    p.set_defaults(func=cmd_action)
    p = sub.add_parser('ls', help='list a directory, e.g. plugin://plugin.video.jellycon/')
    p.add_argument('url')
    p.add_argument('--json', action='store_true')
    p.add_argument('--full', action='store_true', help='do not shorten paths')
    p.set_defaults(func=cmd_ls)
    p = sub.add_parser('screenshot', help='save a screenshot, prints its path')
    p.add_argument('name', nargs='?')
    p.set_defaults(func=cmd_screenshot)
    p = sub.add_parser('log', help='show kodi.log of the current Kodi run')
    p.add_argument('-n', '--lines', type=int, default=50)
    p.add_argument('-g', '--grep')
    p.add_argument('-a', '--all', action='store_true', help='include earlier Kodi runs')
    p.set_defaults(func=cmd_log)

    p = sub.add_parser('jf', help='call the Jellyfin API with the admin API key')
    p.add_argument('method')
    p.add_argument('path')
    p.add_argument('body', nargs='?', help='JSON body')
    p.set_defaults(func=cmd_jf)
    p = sub.add_parser('user', help='show, enable or disable a Jellyfin test user')
    p.add_argument('name')
    p.add_argument('state', nargs='?', choices=('enable', 'disable'))
    p.set_defaults(func=cmd_user)
    p = sub.add_parser('userdata', help='server-side played state and resume position of an item')
    p.add_argument('user')
    p.add_argument('item', help='item id or name from seed.json, e.g. "Kdev Alpha" or "Kdev Show Pilot"')
    p.set_defaults(func=cmd_userdata)

    p = sub.add_parser('fault', help='fail requests to Jellyfin that go through the fault proxy',
                       description='The add-on must use http://faultproxy:8096 as server address. '
                                   'Rules fire on requests whose path matches MATCH, a regular expression.')
    p.add_argument('action', choices=('show', 'add', 'clear'))
    p.add_argument('match', nargs='?')
    p.add_argument('--method', help='only requests with this HTTP method')
    p.add_argument('--status', type=int, help='answer with this status (default 500, 200 with --body)')
    p.add_argument('--body', help='answer with this response body instead of passing the request on')
    p.add_argument('--content-type', default='application/json', help='content type of --body (default application/json)')
    p.add_argument('--drop', action='store_true', help='close the connection without an answer')
    p.add_argument('--delay', type=float, help='pass the request on after this many seconds')
    p.add_argument('--times', type=int, help='fire this many times only')
    p.add_argument('-n', '--lines', type=int, default=20, help='fired requests to show')
    p.set_defaults(func=cmd_fault)

    args = parser.parse_args()
    use_instance(args.instance)
    args.func(args)


if __name__ == '__main__':
    main()
